# ============================================================
# CognoDB Graph Database Benchmark — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git.
# ============================================================

# --- CognoDB Cloud ---
COGNODB_URI=bolt+s://your-cognodb-host:7687
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_cognodb_password

# --- Neo4j AuraDB ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --- Memgraph Cloud ---
MEMGRAPH_URI=bolt+s://your-memgraph-host:7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=your_memgraph_password

# --- ArangoDB Oasis ---
ARANGODB_URL=https://your-arangodb-host
ARANGODB_USER=root
ARANGODB_PASSWORD=your_arangodb_password
ARANGODB_DB=benchmark

# --- TigerGraph Cloud Starter ---
TIGERGRAPH_HOST=https://your-org.i.tgcloud.io
TIGERGRAPH_USER=tigergraph
TIGERGRAPH_PASSWORD=your_tigergraph_password
